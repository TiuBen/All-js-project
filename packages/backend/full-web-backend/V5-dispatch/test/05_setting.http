### 5.19 新增
### ------------------------------------------------------------
# @name newAirline
POST {{host}}/api/setting/airlines
Content-Type: application/json

{
  "chinese_airplane_company_name": "测试航空ZZ",
  "airplane_company_iata_code": "QZ",
  "airplane_company_icao_code": "QZZZ"
}

### 期望 201：{ "id": 16, "chinese_airplane_company_name": "测试航空ZZ",
###             "airplane_company_iata_code": "QZ", "airplane_company_icao_code": "QZZZ" }


### ------------------------------------------------------------
### 5.20 唯一冲突 → 409
### ------------------------------------------------------------
POST {{host}}/api/setting/airlines
Content-Type: application/json

{
  "chinese_airplane_company_name": "测试航空ZZ"
}

### 期望 409：{ "error": "该记录已存在（唯一约束冲突）" }


### ------------------------------------------------------------
### 5.21 更新
### ------------------------------------------------------------
PUT {{host}}/api/setting/airlines/{{newAirline.response.body.$.id}}
Content-Type: application/json

{
  "airplane_company_icao_code": "QZYY"
}

### 期望 200，airplane_company_icao_code 变成 QZYY


### ------------------------------------------------------------
### 5.22 删除 + 收尾
### ------------------------------------------------------------
DELETE {{host}}/api/setting/airlines/{{newAirline.response.body.$.id}}

###
GET {{host}}/api/setting/airlines
