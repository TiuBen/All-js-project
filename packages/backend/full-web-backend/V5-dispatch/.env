# Server
PORT=5183
HOST=0.0.0.0

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=admin
PG_DATABASE=flight_dispatch

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Prisma —— prisma.config.ts 里读这个（Prisma 不接受分散的 PG_* 变量）
# 值必须和上面的 PG_* 保持一致：postgresql://用户:密码@主机:端口/库名?schema=public
DATABASE_URL="postgresql://postgres:admin@127.0.0.1:5432/flight_dispatch?schema=public"

# ========== 航班监控（每天 00:01 灌当日计划进 ecyilang → 定时增量比对 → SSE 通知） ==========
# 总开关：false 时不自动跑（仍可 POST /api/monitor/trigger 手动触发）
MONITOR_ENABLED=true

# ⭐ 每天重灌当日计划的时刻（默认 00:01 = 过零点一分抓当天的航班计划）
MONITOR_PLAN_HOUR=0
MONITOR_PLAN_MINUTE=1

# ⭐ 比对间隔（分钟）—— 改这一处
MONITOR_INTERVAL_MINUTES=15

# 远程接口
MONITOR_URL=http://ffqs.hublairport.com/fqs-api/OffsiteFlight/selectMontageFlight?t=td

# 单次拉取超时（毫秒）
MONITOR_TIMEOUT_MS=20000

# 拉取失败自动重试（默认重试 2 次、间隔 1 秒；0 = 不重试）
MONITOR_RETRY_COUNT=2
MONITOR_RETRY_DELAY_MS=1000

# 🔴 断崖保护：本轮比基线少的比例超过它就跳过本轮（不发通知）。
# 0.5 = 少一半就停手。接口挂掉时不至于把当天所有航班一次性报成「减少」。
MONITOR_DROP_RATIO_LIMIT=0.5

# 通知 webhook（钉钉/企微/飞书机器人通用 text 格式）。留空 = 只落库 + 控制台打印
MONITOR_WEBHOOK_URL=

# ⭐ 推送鉴权令牌：本地电脑拉数推给本服务 /api/monitor/plan、/trigger 时，请求头 x-push-token 要等于它。
# 留空 = 不校验（仅本地开发）；生产务必填一个随机串。
MONITOR_PUSH_TOKEN=ddafdsfafadsfasdfasdfasd
SERVER_URL=https://dd.atc1215.cn 
PUSH_TOKEN=ddafdsfafadsfasdfasdfasd 

; NODE_ENV=production
; LOG_LEVEL=warn