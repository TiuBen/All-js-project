generator client {
  provider            = "prisma-client"
  output              = "./generated"
  // 下面三个是给 seed 用的：Prisma 7 的 prisma-client 生成器只产 TypeScript，
  // 纯 JS 项目必须用 tsx 执行 seed，而 tsx 找不到 .js 后缀对应的 .ts 源文件，
  // 所以把生成的 import 后缀写成 .ts（官方对 tsx 的推荐写法）。
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  // ⚠️ 连接串不写在这里 —— Prisma 7 起改由 prisma.config.mjs 的 datasource.url 提供，
  //    在 datasource 块内再写该字段会被 CLI 直接拒绝（错误码 P1012）。
}

// ============================================================
// 一、航班主数据（三张表互为「不同来源的航班」，id 都是随机 uuid v4）
// ============================================================

/// fips 
model fips {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task            String? @db.VarChar(8)
  flight_no       String? @db.VarChar(32)
  origin_station  String? @db.VarChar(8)
  dest_station    String? @db.VarChar(8)
  landing_station String? @db.VarChar(8)
  in_out_time     String? @db.VarChar(19)
  sobt            String? @db.VarChar(19)
  eobt            String? @db.VarChar(19)
  atot            String? @db.VarChar(19)
  sibt            String? @db.VarChar(19)
  eldt            String? @db.VarChar(19)
  aldt            String? @db.VarChar(19)
  corridor        String? @db.VarChar(16)
  runway          String? @db.VarChar(16)
  stand           String? @db.VarChar(16)
  aircraft_type   String? @db.VarChar(16)
  source_file     String? @db.VarChar(32)
  source_date     String? @db.VarChar(16)
  mapped_date     String? @db.VarChar(16)

  checklists records_checklist[] @relation("fips_checklists")
  specials   records_special[]   @relation("fips_specials")
}

/// manual_fips —— 用户在航班列表页手动添加的航班
/// 字段对齐 fips
model manual_fips {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task            String? @db.VarChar(16)
  flight_no       String  @db.VarChar(32)
  origin_station  String? @db.VarChar(16)
  dest_station    String? @db.VarChar(16)
  landing_station String? @db.VarChar(16)
  in_out_time     String? @db.VarChar(32)
  sobt            String? @db.VarChar(32)
  eobt            String? @db.VarChar(32)
  atot            String? @db.VarChar(32)
  sibt            String? @db.VarChar(32)
  eldt            String? @db.VarChar(32)
  aldt            String? @db.VarChar(32)
  corridor        String? @db.VarChar(16)
  runway          String? @db.VarChar(16)
  stand           String? @db.VarChar(16)
  aircraft_type   String? @db.VarChar(32)
  landing_time    String? @db.VarChar(32)

  checklists records_checklist[] @relation("manual_fips_checklists")
  specials   records_special[]   @relation("manual_fips_specials")
}

// ecyilang -- 从花湖翼览上获取的数据
model ecyilang {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// ★ 航班可读唯一键（监控用）：a_flight_date|a_flight_no_full|a_name|d_flight_date|d_flight_no_full|d_name
  ///   日期只取 YYYY-MM-DD。远程每 15 分钟推一次同一批航班，靠它找到本行 uuid 做**增量更新**，
  ///   不整表重灌（历史抓包实测 18 份快照 / 1074 行单份内部 100% 唯一、0 空键，且
  ///   *_flight_type_code 从空补成 H/Z 不会换键 —— 所以任务性质代码刻意不进键）。
  ///   历史手动导入的行此列为 NULL（PG 唯一索引允许多个 NULL，不冲突）。
  flight_readable_id String?   @unique(map: "ecyilang_readable_id_key") @db.VarChar(256)
  /// ★ 属性变更流水（监控写入）：[{ updateTime, snapshot: <当轮整条原始快照> }, ...]
  ///   不记字段级 diff —— 每次比对发现该行有变化，把**整条原始快照**存进来（用户定的，
  ///   调试时能直接看当时的原始数据）。要对比变化就顺数组相邻两条互相 diff。
  changelog          Json?     @db.JsonB
  // ---- 离港侧 ----
  d_flight_type_code String?   @db.VarChar(16)
  d_flight_date      DateTime? @db.Date
  d_plan_time        DateTime? @db.Timestamp(0)
  d_time             DateTime? @db.Timestamp(0)
  d_jx               String?   @db.VarChar(16)
  d_name             String?   @db.VarChar(64)
  d_flight_no_full   String?   @db.VarChar(32)
  d_country_type     String?   @db.VarChar(16)
  d_craft_seat_code  String?   @db.VarChar(16)
  d_state_name       String?   @db.VarChar(32)
  d_abnormal_state   String?   @db.VarChar(16)
  // ---- 进港侧 ----
  a_flight_type_code String?   @db.VarChar(16)
  a_flight_date      DateTime? @db.Date
  a_plan_time        DateTime? @db.Timestamp(0)
  a_time             DateTime? @db.Timestamp(0)
  a_jx               String?   @db.VarChar(16)
  a_flight_no_full   String?   @db.VarChar(32)
  a_country_type     String?   @db.VarChar(16)
  a_name             String?   @db.VarChar(64)
  a_craft_seat_code  String?   @db.VarChar(16)
  a_state_name       String?   @db.VarChar(32)
  a_abnormal_state   String?   @db.VarChar(16)
  // ---- 其它 ----
  k_h                String?   @db.VarChar(8)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  /// 从 *_name 反查出的 IATA / ICAO 码（导入时补全）
  d_name_iata_code   String?   @db.VarChar(8)
  d_name_icao_code   String?   @db.VarChar(8)
  a_name_iata_code   String?   @db.VarChar(8)
  a_name_icao_code   String?   @db.VarChar(8)

  checklists records_checklist[] @relation("ecyilang_checklists")
  specials   records_special[]   @relation("ecyilang_specials")

  @@index([d_flight_date], map: "idx_ecyilang_d_flight_date")
  @@index([a_flight_date], map: "idx_ecyilang_a_flight_date")
}

// ============================================================
// 二、检查单与生鲜台账
// ============================================================

model records_checklist {
  id                 Int     @id @default(autoincrement())
  callsign           String? @db.VarChar(32)
  aircraft_type      String? @db.VarChar(32)
  checklist_category String  @db.VarChar(32)

  items             Json?     @db.JsonB
  video_supervision Json?     @db.JsonB
  /// 检查人 = user 表外键（谁填的这份检查单）
  inspector_id      Int?
  status            String?   @default("draft") @db.VarChar(16)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  // 外键字段（改名后）
  ecyilang_uuid    String? @db.Uuid
  fips_uuid        String? @db.Uuid
  manual_fips_uuid String? @db.Uuid

  // 关系字段
  flight     ecyilang?    @relation("ecyilang_checklists", fields: [ecyilang_uuid], references: [id])
  fips       fips?        @relation("fips_checklists", fields: [fips_uuid], references: [id])
  manualFips manual_fips? @relation("manual_fips_checklists", fields: [manual_fips_uuid], references: [id])
  inspector  user?        @relation("checklist_inspector", fields: [inspector_id], references: [id])
}

model records_special {
  id         Int       @id @default(autoincrement())
  callsign   String    @db.VarChar(32)
  nodes      Json?     @default("{}") @db.JsonB
  /// 检查人 = user 表外键（谁登记的这份生鲜台账）
  inspector_id Int?
  createTime DateTime? @default(now()) @db.Timestamptz(6)
  updateTime DateTime? @default(now()) @db.Timestamptz(6)

  // 外键字段（改名后）
  ecyilang_uuid    String? @db.Uuid
  fips_uuid        String? @db.Uuid
  manual_fips_uuid String? @db.Uuid

  // 关系字段
  flight     ecyilang?    @relation("ecyilang_specials", fields: [ecyilang_uuid], references: [id])
  fips       fips?        @relation("fips_specials", fields: [fips_uuid], references: [id])
  manualFips manual_fips? @relation("manual_fips_specials", fields: [manual_fips_uuid], references: [id])
  inspector  user?        @relation("special_inspector", fields: [inspector_id], references: [id])
}

// ============================================================
// 三、航班监控（每日 00:01 把当日计划灌进 ecyilang → 定时增量比对）
// ------------------------------------------------------------
// ★ 监控**不建自己的表**：基线就是 ecyilang 里当天的数据，
//   变更流水写在 ecyilang.changelog，比对基准（hash → 行）住在内存，
//   服务重启后从 ecyilang 按当天日期重建（见 services/monitorService.js）。
// ============================================================

/// airplane_company_name_code —— 航空公司中文名 ↔ IATA/ICAO 码
model airplane_company_name_code {
  id                            Int     @id @default(autoincrement())
  chinese_airplane_company_name String  @unique(map: "airplane_company_name_code_name_key") @db.VarChar(64)
  airplane_company_iata_code    String? @unique(map: "airplane_company_name_code_iata_key") @db.VarChar(8)
  airplane_company_icao_code    String? @unique(map: "airplane_company_name_code_icao_key") @db.VarChar(8)
}

/// airport_name_code —— 机场中文名/英文名 ↔ IATA/ICAO 码
model airport_name_code {
  id                   Int     @id @default(autoincrement())
  chinese_airport_name String  @unique(map: "airport_name_code_name_key") @db.VarChar(64)
  english_airport_name String? @db.VarChar(96)
  airport_iata_code    String? @unique(map: "airport_name_code_iata_key") @db.VarChar(8)
  airport_icao_code    String? @unique(map: "airport_name_code_icao_key") @db.VarChar(8)
}

// ============================================================
// 四、用户（花名册）与登录日志
// ============================================================

/// user —— 值班员花名册（检查单 / 生鲜台账的检查人 + 登录日志关联到这里）
/// 前端不做本表的 CRUD 界面（由用户自己写），这里提供 /api/user 全套接口。
model user {
  id        Int     @id @default(autoincrement())
  /// 姓名（唯一）：登录日志、检查单都靠名字对回这一行
  name      String  @unique(map: "user_name_key") @db.VarChar(64)
  telephone String? @db.VarChar(32)

  checklists records_checklist[] @relation("checklist_inspector")
  specials   records_special[]   @relation("special_inspector")
  loginLogs  user_login_log[]    @relation("user_login_logs")
}

/// user_login_log —— 谁在什么时间登录、什么时间登出
/// 一行 = 一场登录：切换用户时先给上一场盖 logout_time，再插新的一行。
/// logout_time 为空 = 这一场还开着（人还在用）。
/// ★ username 是当时的流水记录（历史留痕 + 查询口径不变），
///   user_id 是对花名册的引用（按 username 现解析；对不上时留空，不拦登录）。
model user_login_log {
  id          Int       @id @default(autoincrement())
  username    String    @db.VarChar(64)
  /// 花名册引用：create 时按 username 在 user 表里现查，查到就记 id
  user_id     Int?
  /// 登录时间：建行时由数据库 now() 盖（客户端不用传，也避免机器时钟不准）
  login_time  DateTime  @default(now()) @db.Timestamptz(6)
  /// 登出时间：走 POST /api/user-log/:id/logout 由服务端盖；为空 = 未登出
  logout_time DateTime? @db.Timestamptz(6)

  user user? @relation("user_login_logs", fields: [user_id], references: [id])

  /// 两列都是 timestamptz（绝对时刻）→ 展示 / 分天走 utils/date.js 的 cn* 系列
  @@index([login_time], map: "idx_user_login_log_login_time")
  @@index([username], map: "idx_user_login_log_username")
}
