user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;
include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;

    include /etc/nginx/mime.types;

    default_type application/octet-stream;
    gzip on;

    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        text/xml
        application/xml
        application/xml+rss
        text/javascript;

    #################################
    # 全局安全头
    #################################
    add_header Strict-Transport-Security 
    "max-age=31536000; includeSubDomains" always;

    add_header X-Frame-Options 
    "SAMEORIGIN" always;

    add_header X-Content-Type-Options 
    "nosniff" always;

    add_header X-XSS-Protection 
    "1; mode=block" always;

    #################################
    # HTTP
    #################################
    # 域名跳HTTPS
    server {
        listen 80;
        listen [::]:80;
        server_name atc1215.cn www.atc1215.cn admin.atc1215.cn new.atc1215.cn jcd.atc1215.cn;
        return 301 https://$host$request_uri;
    }

    # 禁止IP访问

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        return 444;
    }

    #################################
    # 主站
    # atc1215.cn + www
    #################################
    server {
        listen 443 ssl http2;
        server_name atc1215.cn www.atc1215.cn;

        ssl_certificate /etc/letsencrypt/live/atc1215.cn/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/atc1215.cn/privkey.pem;
        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

        root  /usr/zhec-tower-v3-mobile-https/;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }
        # API
        location /api {
            proxy_pass http://127.0.0.1:3205;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
        # 图片
       location ^~ /images/{
            alias /usr/zhec-tower-v3-server/public/images/;
            expires 90d;
            access_log off;
            add_header Cache-Control "public,max-age=2592000";
        }

        # 静态文件缓存
        location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|map)$ {
            expires 30d;
            access_log off;
        }
    }

    #################################
    # 后台 admin
    #################################
    server {
        listen 443 ssl http2;
        server_name admin.atc1215.cn;

        ssl_certificate /etc/letsencrypt/live/atc1215.cn/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/atc1215.cn/privkey.pem;
        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

        root /usr/zhec-tower-v3-admin-https/;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location /api {
            proxy_pass http://127.0.0.1:3205;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

       location ^~ /images/ {
            alias /usr/zhec-tower-v3-server/public/images/;
            expires 90d;
            access_log off;
        }

        # 静态文件缓存
        location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|map)$ {
            expires 30d;
            access_log off;
        }
    }

    #################################
    # new 新进离场程序
    #################################
    server {
        listen 443 ssl http2;
        server_name new.atc1215.cn;

        ssl_certificate /etc/letsencrypt/live/atc1215.cn/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/atc1215.cn/privkey.pem;
        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

        root /usr/zhec-tower-newRoute20260219-https/;
        index index.html;
        
        location / {
            try_files $uri $uri/ /index.html;
        }

        location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|map)$ {
            expires 30d;
            access_log off;
        }
    }

    #################################
    # jcd
    #################################
    server {
        listen 443 ssl http2;
        server_name jcd.atc1215.cn;
        ssl_certificate /etc/letsencrypt/live/atc1215.cn/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/atc1215.cn/privkey.pem;

        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

        root /usr/zhec-jcd-demo/;
        index index.html;
        location / {
            try_files $uri $uri/ /index.html;
        }
        location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|map)$ {
            expires 30d;
            access_log off;
        }
    }
}